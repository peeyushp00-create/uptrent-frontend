# Copy this file to .env.local for local development (gitignored, takes
# priority over the committed .env). The committed frontend/.env intentionally
# tracks the production backend URL and Supabase's public anon key — neither
# is a secret (Vite bakes all VITE_* vars into the client bundle regardless).

VITE_API_URL=http://localhost:3001
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
VITE_GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
